{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v9-skills.local/schemas/brief.schema.json",
  "title": "v9 Video Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "domain", "objective", "sourceMaterials"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string"
    },
    "sourceMaterials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["pdf", "docx", "url", "text", "audio", "other"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspectRatio": {
          "type": "string"
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "language": {
          "type": "string"
        },
        "publication": {
          "type": "string"
        }
      }
    }
  }
}
